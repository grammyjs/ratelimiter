{
	"name": "@grammyjs/ratelimiter",
	"version": "2.0.0",
	"description": "The most advanced and flexible rate-limiter for grammY.",
	"type": "module",
	"scripts": {
		"build": "deno2node --project tsconfig.json",
		"test:deno": "deno task ok",
		"test:node": "npm run build && node --test tests/node.test.mjs",
		"test": "npm run test:deno && npm run test:node"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/grammyjs/ratelimiter.git"
	},
	"files": [
		"dist/"
	],
	"main": "./dist/mod.js",
	"module": "./dist/mod.js",
	"types": "./dist/mod.d.ts",
	"exports": {
		".": {
			"types": "./dist/mod.d.ts",
			"import": "./dist/mod.js"
		},
		"./storages": {
			"types": "./dist/storages.d.ts",
			"import": "./dist/storages.js"
		}
	},
	"keywords": [
		"grammy",
		"grammy-plugin",
		"telegraf",
		"bot",
		"ratelimiter",
		"rate-limit",
		"telegram",
		"telegram-bot",
		"middleware",
		"spam-protection"
	],
	"author": "Amir Zouerami",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/grammyjs/ratelimiter/issues"
	},
	"homepage": "https://github.com/grammyjs/ratelimiter#readme",
	"peerDependencies": {
		"@grammyjs/grammy": ">=2.0.0-beta.6 <3"
	},
	"devDependencies": {
		"@grammyjs/grammy": "npm:@jsr/grammyjs__grammy@2.0.0-beta.6",
		"@types/node": "^20.11.20",
		"deno2node": "^1.16.0"
	}
}
